  "samples": [
    {
      "id": "T2-01",
      "description": "Percent-encoded SQLi",
      "request": {
        "method": "GET",
        "path": "/search?q='%20OR%201%3D1--",
        "headers": {
          "user-agent": "Mozilla/5.0 (WAF Studio synthetic fixture)"
        },
        "body": null
      },
      "expected": {
        "verdict": "block",
        "categories": [
          "sqli"
        ]
      }
    },
    {
      "id": "T2-02",
      "description": "Double URL encoding",
