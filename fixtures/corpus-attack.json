    {
      "id": "CA-001",
      "description": "Numeric tautology in query",
      "request": {
        "method": "GET",
        "path": "/search?q='%20OR%201%3D1--",
        "headers": {
          "user-agent": "Mozilla/5.0 (WAF Studio synthetic fixture)"
        },
        "body": null
      },
      "expected": {
        "verdict": "block",
        "categories": [
          "sqli"
        ]
      }
    },
    {
