{
  "case": "T3",
  "title": "Benign false-positive probes",
  "description": "Ordinary, synthetic inputs that look a little like attacks (apostrophes, ampersands, SQL/HTML words, symbols, markdown, code, non-ASCII). Every sample must be allowed with the default rules and configuration. All names, e-mails and credentials are fictitious.",
  "samples": [
    {
      "id": "T3-01",
      "description": "Surname with an apostrophe in a search",
      "request": {
        "method": "GET",
        "path": "/search?q=O'Brien",
        "headers": {
          "user-agent": "Mozilla/5.0 (fixture)"
        },
        "body": null
      },
      "expected": {
        "verdict": "allow",
        "categories": []
      }
    },
    {
