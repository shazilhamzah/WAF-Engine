{
  "case": "T5",
  "title": "Evasion and bypass attempts",
  "description": "Expected verdict remains block even for documented misses. Cross-field/base64 examples are conditional on application interpretation, not confirmed exploits of Vulnerable Shop.",
  "samples": [
    {
      "id": "T5-01",
      "description": "Comment-split UNION and SELECT",
      "request": {
        "method": "GET",
        "path": "/search?q=1%20UN%2F**%2FION%20SEL%2F**%2FECT%201%2C2",
        "headers": {
          "user-agent": "Mozilla/5.0 (WAF Studio synthetic fixture)"
        },
        "body": null
      },
      "expected": {
        "verdict": "block",
        "categories": [
          "sqli"
        ]
      }
    },
    {
      "id": "T5-02",
      "description": "Mixed case and horizontal tabs",
